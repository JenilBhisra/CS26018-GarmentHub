model ReturnRequest {
  id            String       @id @default(uuid())
  orderId       String       @unique
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reason        String
  description   String?
  status        ReturnStatus @default(REQUESTED)
  adminNotes    String?
  refundAmount           Decimal                 @db.Decimal(12, 2)
  originalShippingFee    Decimal                 @default(0) @db.Decimal(12, 2)
  returnShippingFee      Decimal                 @default(0) @db.Decimal(12, 2)
  shippingResponsibility ShippingResponsibility?
  reasonCategory         ReturnReasonCategory?
  deductionAmount                Decimal                 @default(0) @db.Decimal(12, 2)
  sellerDeductionAmount          Decimal                 @default(0) @db.Decimal(12, 2)
  customerRefundAmount           Decimal                 @default(0) @db.Decimal(12, 2)
  restoreStock                   Boolean                 @default(true)
  stockRestored                  Boolean                 @default(false)
  reference                      String                  @unique // For financial idempotency
  returnReasonRuleId             String?
  returnReasonRule               ReturnReasonRule?       @relation(fields: [returnReasonRuleId], references: [id], onDelete: SetNull)
  reverseCommission              Boolean                 @default(false)
  platformCost                   Decimal                 @default(0) @db.Decimal(12, 2)
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt

  // Reporting permanent fields
  orderNumber                    String?
  sellerStoreName                String?
  customerName                   String?
  customerEmail                  String?
  productName                    String?
  productSku                     String?
  quantity                       Int                     @default(1)
  productAmount                  Decimal                 @default(0) @db.Decimal(12, 2)
  originalShippingResponsibility ShippingResponsibility?
  returnShippingResponsibility   ShippingResponsibility?
  whoPaidProductRefund           String?                 // "Seller" or "Platform"
  whoPaidOriginalShipping        String?                 // "Seller" or "Platform" or "Customer"
  whoPaidReturnShipping          String?                 // "Seller" or "Platform" or "Customer"
  walletTransactionRef           String?
  ledgerTransactionRef           String?
  approvedAt                     DateTime?
  refundedAt                     DateTime?
  tagLoopVerified                Boolean?
  tagLoopMismatchNote            String?

  @@index([orderId])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([returnReasonRuleId])
  @@index([createdAt])
  @@index([refundedAt])
  @@index([reasonCategory])
  @@index([shippingResponsibility])
}

model Dispute {
