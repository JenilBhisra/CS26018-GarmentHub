// ============================================================
// PHASE 16 — MULTI-CHANNEL FOUNDATION (MASTER PRODUCT / CHANNEL LISTING)
// ============================================================
// Product/ProductVariant remain the canonical "Master Product" — nothing here
// changes their shape. GarmentHub itself is modeled as a SalesChannel (type
// NATIVE) so external channels (Amazon, Flipkart, etc. — added in a later,
// separate phase) plug into the exact same structures rather than needing
// their own bespoke tables. A ProductVariant with no ChannelListing row for a
// given channel is implicitly "as-is on that channel" — rows are only created
// once a listing needs channel-specific overrides (price, SKU, status), so
// connecting GarmentHub's own channel does NOT require backfilling a row per
// existing product/variant.

enum ChannelType {
  NATIVE
  EXTERNAL
}

enum ChannelConnectionStatus {
  ACTIVE
  DISCONNECTED
  ERROR
  PENDING
}

enum ChannelListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  FAILED
  PAUSED
  ARCHIVED
}

model SalesChannel {
  id             String                 @id @default(uuid())
  code           String                 @unique // "GARMENTHUB", "AMAZON", "FLIPKART", ...
  name           String
  type           ChannelType            @default(EXTERNAL)
  isActive       Boolean                @default(true)
  sellerAccounts SellerChannelAccount[]
  listings       ChannelListing[]
  orders         Order[]
  inventoryTransactions InventoryTransaction[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

// A seller's connection to a channel. For GarmentHub (NATIVE) this is an
// implicit always-on account; for external channels this becomes the
// credential/connector-state record from the future connector phase.
model SellerChannelAccount {
  id                String                  @id @default(uuid())
  sellerId          String
  seller            SellerProfile           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  channelId         String
  channel           SalesChannel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  status            ChannelConnectionStatus @default(ACTIVE)
  externalAccountId String? // e.g. Amazon seller ID — null for GarmentHub native
  displayName       String?
  credentials       Json? // Opaque/encrypted blob for future connector credentials — unused by GarmentHub native
  lastSyncedAt      DateTime?
  lastSyncError     String?
  listings          ChannelListing[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([sellerId, channelId, externalAccountId])
  @@index([sellerId])
  @@index([channelId])
}

// Per-variant, per-channel representation. Only created once a variant needs
// channel-specific data — see banner comment above.
model ChannelListing {
  id                     String                @id @default(uuid())
  variantId              String
  variant                ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sellerChannelAccountId String
  sellerChannelAccount   SellerChannelAccount  @relation(fields: [sellerChannelAccountId], references: [id], onDelete: Cascade)
  channelId              String
  channel                SalesChannel          @relation(fields: [channelId], references: [id])
  externalListingId      String? // The marketplace's own ID for this listing, null until published
  channelSku             String?
  priceOverride          Decimal?              @db.Decimal(12, 2)
  status                 ChannelListingStatus  @default(DRAFT)
  syncError              String?
  lastSyncedAt           DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([variantId, channelId])
  @@index([variantId])
  @@index([sellerChannelAccountId])
  @@index([channelId])
  @@index([status])
}

// ============================================================
// PHASE 17 — INVENTORY LEDGER FOUNDATION
// ============================================================
// ProductVariant.stock remains the fast-read "current total" — nothing reads
// or writes it differently. This ledger is purely additive bookkeeping that
// records WHY each stock change happened, written in the SAME transaction as
// the stock mutation itself so the two can never drift apart. channelId/
// orderId/orderItemId are all nullable so this same table can represent a
// GarmentHub-native sale today and an external-marketplace sale later without
// a schema change.

enum InventoryMovementType {
  RECEIVED             // Stock received (initial load or restock)
  SALE                 // Deducted for a placed order
  RESERVATION          // Reserved for a pending order, not yet deducted (future use)
  RESERVATION_RELEASE  // A reservation was released without a sale (future use)
  CANCELLATION         // Returned to stock because an order was cancelled
  RETURN_RESTOCK       // Returned to stock because a customer return was approved
  DAMAGED              // Removed from sellable stock due to damage
  ADJUSTMENT           // Manual correction by a seller/admin
}

model InventoryTransaction {
  id             String                @id @default(uuid())
  variantId      String
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type           InventoryMovementType
  quantityChange Int // Signed: positive = stock increased, negative = decreased
  quantityBefore Int
  quantityAfter  Int
  orderId        String?
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId    String?
  orderItem      OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  channelId      String? // Null = GarmentHub native
  channel        SalesChannel?         @relation(fields: [channelId], references: [id], onDelete: SetNull)
  reason         String? // Free-text note, used for manual adjustments
  reference      String?               @unique // Idempotency key, e.g. "orderitem:<id>:sale"
  actorUserId    String? // Who performed a manual adjustment; null for system-driven movements
  createdAt      DateTime              @default(now())

  @@index([variantId])
  @@index([sellerId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model InsightRecommendation {
  id              String                 @id @default(uuid())
  sellerId        String?
  seller          SellerProfile?         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  marketInsightId String?
  marketInsight   MarketInsight?         @relation(fields: [marketInsightId], references: [id], onDelete: Cascade)
  title           String
  description     String
  priority        RecommendationPriority @default(MEDIUM)
  status          RecommendationStatus   @default(OPEN)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([sellerId])
  @@index([marketInsightId])
}


