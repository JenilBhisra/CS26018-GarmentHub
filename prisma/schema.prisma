  pageType  String   // "HOMEPAGE" | "PRODUCT_PAGE" | "CATEGORY_PAGE" | "SEARCH_PAGE" | "B2B_PAGE"
  productId String?
  createdAt DateTime @default(now())

  @@index([pageType])
  @@index([createdAt])
}

model SearchAnalytics {
