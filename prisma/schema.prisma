datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SELLER
  B2B_VENDOR
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum ShippingStatus {
  PENDING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PackLogStatus {
  OPEN
  DISPATCHED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REJECTED
  REVERSED
}

enum TransactionType {
  EARNING
  PAYOUT
  REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
  RELEASE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  REFUNDED
  CLOSED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  WAITING_FOR_SELLER
  WAITING_FOR_CUSTOMER
  RESOLVED
  REJECTED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String?        @unique
  name          String
  passwordHash  String? // Nullable if using social logins later
  role          Role           @default(CUSTOMER)
  image         String?
  emailVerified DateTime?
  sellerProfile SellerProfile?
  b2bProfile    B2BProfile?
  carts         Cart?
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  reviews       Review[]
  wishlists     Wishlist[]
  questions     ProductQuestion[]
  reviewReports ReviewReport[]
  conversations ConversationParticipant[]
  messages      Message[]
  reactions     MessageReaction[]
  auditLogs     AuditLog[]
  disputes      Dispute[]
  disputeNotes  DisputeNote[]
  returnRequests ReturnRequest[]
  walletAdjustments WalletAdjustment[]
  preferences       UserPreference?
  lastActiveAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// NextAuth v5 / Auth.js adapter models
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SellerProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName          String
  storeSlug          String         @unique
  commissionRate     Float          @default(0.10) // e.g. 10% platform commission
  pickupAddress      String
  approvalStatus     ApprovalStatus @default(PENDING)
  rejectedReason     String?
  verifiedAt         DateTime?
  GSTIN              String?
  PAN                String?
  Aadhaar            String?
  // TODO: In production, the following bank account fields must be tokenized or encrypted.
  // Do not store plain text bank details long-term in an unencrypted table.
  bankAccountHolder  String?
  bankAccountNumber  String?
  bankIFSC           String?
  bankName           String?
  products           Product[]
  orders             Order[]
  wallet             SellerWallet?
  kyc                SellerKYC?
  quotes             Quote[]
  answers            ProductAnswer[]
  coupons            Coupon[]        // Seller-scoped coupons
  promotions         Promotion[]     // Seller-created promotions
  payoutRequests     PayoutRequest[]
  returnRequests     ReturnRequest[]
  disputes           Dispute[]
  packLogs           PackLog[]
  channelAccounts    SellerChannelAccount[]
  inventoryTransactions           InventoryTransaction[]
  sellerInsights                 SellerInsight[]
  sellerMetricSnapshot           SellerMetricSnapshot?
  insightRecommendations         InsightRecommendation[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Category {
  id         String      @id @default(uuid())
  name       String
  slug       String      @unique
  image      String?
  products   Product[]
  coupons    Coupon[]    // Category-scoped coupons
  promotions Promotion[] // Category promotions
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Product {
  id           String         @id @default(uuid())
  sellerId     String
  seller       SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  name            String
  slug            String          @unique
  brand           String
  description  String?
  images       String[]
  status          ProductStatus  @default(DRAFT)
  isB2BEnabled    Boolean        @default(false)
  isB2BApproved   Boolean        @default(false)
  isFeatured      Boolean        @default(false)
  rating          Float          @default(0)
  averageRating   Float          @default(0)
  reviewsCount    Int            @default(0)
  variants        ProductVariant[]
  rfqs            RFQ[]
  reviews         Review[]
  wishlists       Wishlist[]
  questions       ProductQuestion[]
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  videoUrl        String?

  // Advanced Listing Fields
  manufacturerName  String?
  modelNumber       String?
  productCode       String?
  tags              String[]
  shortDescription  String?
  longDescription   String?
  careInstructions  String?
  countryOfOrigin   String?
  hsnCode           String?
  gstRate           Float?   // Percentage, e.g. 5, 12, 18 — used on generated tax invoices

  specifications    Json?

  maxCapacity       String?
  dispatchTime      String?
  bulkPriceTiers    Json?
  packagingDetails  String?

  weight            Float?
  dimensions        String?
  shippingClass     String?

  seoTitle          String?
  seoDescription    String?
  seoKeywords       String[]
  ogImage           String?

  certifications    String[]
  warrantyInfo      String?
  returnPolicy      String?
  replacementPolicy String?

  coupons           Coupon[]         // Product-scoped coupons
  promotionProducts PromotionProduct[] // Products included in promotions
  analytics         ProductAnalytics?
  conversations     Conversation[]
  disputes          Dispute[]
  productMetricSnapshots ProductMetricSnapshot[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
}

model ProductVariant {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String?     @unique
  size         String?
  color        String?
  mrp          Decimal        @db.Decimal(12, 2)
  sellingPrice Decimal        @db.Decimal(12, 2)
  stock        Int            @default(0)
  moq          Int? // Minimum Order Quantity for B2B transactions
  bulkPrice    Decimal?       @db.Decimal(12, 2) // Bulk price per unit if MOQ is met
  images       String[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  channelListings ChannelListing[]
  inventoryTransactions InventoryTransaction[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId])
}

model Cart {
  id                 String     @id @default(uuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              CartItem[]
  appliedCouponCode  String?    // Coupon code persisted between page loads
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                      String         @id @default(uuid())
  userId                  String
  user                    User           @relation(fields: [userId], references: [id])
  sellerId                String
  seller                  SellerProfile  @relation(fields: [sellerId], references: [id])
  orderNumber             String         @unique
  subtotal                Decimal        @db.Decimal(12, 2)
  shippingFee             Decimal        @db.Decimal(12, 2)
  platformFee             Decimal        @db.Decimal(12, 2)
  commissionAmount        Decimal        @db.Decimal(12, 2)
  commissionRate          Float          @default(0.10)
  sellerEarning           Decimal        @db.Decimal(12, 2) @default(0)
  discountAmount          Decimal        @db.Decimal(12, 2) @default(0) // Coupon/promotion discount applied
  totalAmount             Decimal        @db.Decimal(12, 2)
  couponId                String?        // Reference to coupon used (if any)
  coupon                  Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsages            CouponUsage[]
  status                  OrderStatus    @default(PENDING)
  paymentStatus           PaymentStatus  @default(PENDING)
  paymentMethod           String?
  paymentReference        String?
  shippingStatus          ShippingStatus @default(PENDING)
  shippingProvider        String?
  shippingTrackingNumber  String?
  shippingAddress         String
  shippingState           String?
  shippingCity            String?
  shippingPincode         String?
  packLogId               String?
  packLog                 PackLog?       @relation(fields: [packLogId], references: [id], onDelete: SetNull)
  // Additive, nullable channel identification — null means "GarmentHub native" (no
  // channel has been backfilled onto historical orders, and current checkout does not
  // set these yet). Reserved for the future external-marketplace order-import phase.
  channelId               String?
  channel                 SalesChannel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  externalOrderId         String?
  items                   OrderItem[]
  inventoryTransactions   InventoryTransaction[]
  commissions             Commission[]
  paymentTransactions     PaymentTransaction[]
  shipment                Shipment?
  conversations           Conversation[]
  returnRequest           ReturnRequest?
  disputes                Dispute[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([userId])
  @@index([sellerId])
  @@index([packLogId])
  @@index([shippingState])
  @@index([channelId])
}

model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sellerId        String // Direct reference for indexing and grouping
  quantity        Int
  price           Decimal         @db.Decimal(12, 2)
  productSnapshot Json // Freezes product name, description, brand, images
  variantSnapshot Json // Freezes size, color, SKU
  scannedAt       DateTime?       // Set when scanned during Scan & Pack
  tagLoopNumber   String?         @unique // Tamper-evident tag applied at pack time, checked against on return
  binLabel        String?         // Tmp bin label recorded at scan time, for audit history only
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  review          Review?
  inventoryTransactions InventoryTransaction[]

  @@index([orderId])
  @@index([variantId])
  @@index([sellerId])
  @@index([createdAt])
}

model SellerWallet {
  id                  String              @id @default(uuid())
  sellerId            String              @unique
  seller              SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  availableBalance    Decimal             @db.Decimal(12, 2) @default(0) // Legacy mapping for safety
  withdrawableBalance Decimal             @db.Decimal(12, 2) @default(0)
  pendingBalance      Decimal             @db.Decimal(12, 2) @default(0)
  negativeBalance     Decimal             @db.Decimal(12, 2) @default(0)
  reserveBalance      Decimal             @db.Decimal(12, 2) @default(0)
  totalEarned         Decimal             @db.Decimal(12, 2) @default(0)
  totalPaid           Decimal             @db.Decimal(12, 2) @default(0)
  totalRefunded       Decimal             @db.Decimal(12, 2) @default(0)
  transactions        WalletTransaction[]
  adjustments         WalletAdjustment[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model WalletTransaction {
  id             String          @id @default(uuid())
  sellerWalletId String
  wallet         SellerWallet    @relation(fields: [sellerWalletId], references: [id], onDelete: Cascade)
  amount         Decimal         @db.Decimal(12, 2)
  type           TransactionType
  status         PayoutStatus    @default(PENDING)
  description    String?
  releaseAt      DateTime?
  isReleased     Boolean         @default(false)
  reference      String?         @unique // For financial idempotency
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sellerWalletId])
}

model Commission {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId  String
  rate      Float
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([orderId])
  @@index([sellerId])
}

// B2B Vendor profile — separate from SellerProfile since B2B vendors buy, not sell.
model B2BProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  companySlug    String         @unique
  GSTIN          String?
  PAN            String?
  address        String
  approvalStatus ApprovalStatus @default(PENDING)
  rejectedReason String?
  verifiedAt     DateTime?
  kyc            B2BKYC?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rfqs           RFQ[]

  @@index([approvalStatus])
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model SellerKYC {
  id                    String        @id @default(uuid())
  sellerId              String        @unique
  seller                SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status                KYCStatus     @default(NOT_SUBMITTED)
  gstCertificate        String?
  panCard               String?
  idProof               String?
  addressProof          String?
  bankProof             String?
  
  gstNumber             String?
  panNumber             String?
  idNumber              String?
  bankAccountHolderName String?
  bankAccountNumber     String?
  bankIFSC              String?
  businessRegNumber     String?

  businessAddress       String?
  city                  String?
  state                 String?
  pinCode               String?

  isSuspicious          Boolean       @default(false)
  suspiciousReasons     String[]
  documentValidation    Json?

  rejectionReason       String?
  verifiedAt            DateTime?
  verifiedById          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model B2BKYC {
  id                    String        @id @default(uuid())
  b2bId                 String        @unique
  b2b                   B2BProfile    @relation(fields: [b2bId], references: [id], onDelete: Cascade)
  status                KYCStatus     @default(NOT_SUBMITTED)
  gstCertificate        String?
  panCard               String?
  idProof               String?
  addressProof          String?
  bankProof             String?

  gstNumber             String?
  panNumber             String?
  idNumber              String?
  bankAccountHolderName String?
  bankAccountNumber     String?
  bankIFSC              String?
  businessRegNumber     String?

  businessAddress       String?
  city                  String?
  state                 String?
  pinCode               String?

  isSuspicious          Boolean       @default(false)
  suspiciousReasons     String[]
  documentValidation    Json?

  rejectionReason       String?
  verifiedAt            DateTime?
  verifiedById          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

enum RFQStatus {
  PENDING
  RESPONDED
  CLOSED
}

enum QuoteStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model RFQ {
  id             String      @id @default(uuid())
  buyerId        String
  buyer          B2BProfile  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  targetPrice    Decimal      @db.Decimal(12, 2)
  deliveryCity   String
  notes          String?
  status         RFQStatus   @default(PENDING)
  quotes         Quote[]

  // Audit timestamps
  respondedAt    DateTime?
  closedAt       DateTime?
  lastResponseAt DateTime?
  conversations  Conversation[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([buyerId])
  @@index([productId])
  @@index([status])
}

model Quote {
  id              String         @id @default(uuid())
  rfqId           String
  rfq             RFQ            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  price           Decimal        @db.Decimal(12, 2)
  moq             Int
  leadTime        String
  validityDate    DateTime
  notes           String?
  status          QuoteStatus    @default(SENT)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([rfqId])
  @@index([sellerId])
  @@index([status])
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  RFQ_RECEIVED
  RFQ_RESPONDED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  KYC_APPROVED
  KYC_REJECTED
  SELLER_APPROVED
  SELLER_REJECTED
  B2B_APPROVED
  B2B_REJECTED
  SUSPICIOUS_KYC
  REVIEW_RECEIVED
  REVIEW_REPLY
  QUESTION_RECEIVED
  QUESTION_ANSWERED
  COUPON_CREATED
  PROMOTION_APPROVED
  PROMOTION_REJECTED
  PROMOTION_STARTED
  PROMOTION_EXPIRED
  NEW_MESSAGE
  NEW_SUPPORT_MESSAGE
  RFQ_CHAT_MESSAGE
  ORDER_CHAT_MESSAGE
}

enum ShipmentStatus {
  PENDING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String
  paymentProvider String        // e.g. "Razorpay", "COD"
  paymentMethod   String        // e.g. "Razorpay", "COD"
  transactionId   String?       @unique
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  gatewayResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model Shipment {
  id                    String         @id @default(uuid())
  orderId               String         @unique
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierName           String?
  trackingNumber        String?
  trackingUrl           String?
  estimatedDeliveryDate DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  shippingStatus        ShipmentStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([shippingStatus])
}

// A batch of orders packed together in one Scan & Pack session (OMS-Guru-style Pack Log)
model PackLog {
  id         String        @id @default(uuid())
  name       String        // Auto-generated "YYYY-MM-DD-N", unique per seller per day
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status     PackLogStatus @default(OPEN)
  totalQty   Int           @default(0)
  orderCount Int           @default(0)
  comment    String?
  orders     Order[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([sellerId, name])
  @@index([sellerId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model Review {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId        String?        @unique
  orderItem          OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  rating             Int            // 1-5 validation
  title              String
  comment            String
  isVerifiedPurchase Boolean        @default(false)
  sellerReply        String?
  isHidden           Boolean        @default(false)
  images             ReviewImage[]
  reports            ReviewReport[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId])
  @@index([productId])
}

model ReviewImage {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl String

  @@index([reviewId])
}

model ReviewReport {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([userId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductQuestion {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  isHidden  Boolean         @default(false)
  answers   ProductAnswer[]
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([productId])
}

model ProductAnswer {
  id         String          @id @default(uuid())
  questionId String
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  answer     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([questionId])
  @@index([sellerId])
}

// ============================================================
// PHASE 12 — COUPONS & PROMOTIONS
// ============================================================

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  EXPIRED
  INACTIVE
}

enum PromotionType {
  PRODUCT_DISCOUNT
  CATEGORY_DISCOUNT
  SITEWIDE
  SELLER_SPECIFIC
}

// Coupon — created by admin (any scope) or seller (own products only, no sitewide)
model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  description       String?
  discountType      CouponDiscountType
  discountValue     Decimal            @db.Decimal(12, 2) // Percentage 1-100 or fixed INR amount
  minimumOrderAmount Decimal            @db.Decimal(12, 2) @default(0)
  maximumDiscount   Decimal?           @db.Decimal(12, 2) // Cap on discount for PERCENTAGE coupons
  usageLimit        Int?               // Total usages allowed (null = unlimited)
  perUserLimit      Int                @default(1)
  usageCount        Int                @default(0)
  startDate         DateTime
  endDate           DateTime
  status            CouponStatus       @default(ACTIVE)
  // Targeting — null means unrestricted for that field
  sellerId          String?            // If set, only applies to this seller's products
  seller            SellerProfile?     @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  categoryId        String?            // If set, only applies to this category
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productId         String?            // If set, only applies to this product
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Creator
  createdByAdminId  String?            // Set if created by admin
  createdBySellerId String?            // Set if created by seller (auto-linked)
  usages            CouponUsage[]
  orders            Order[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([code])
  @@index([status])
  @@index([sellerId])
}

// CouponUsage — one record per (coupon × order × user)
model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  discount  Decimal  @db.Decimal(12, 2) // Actual discount applied in this order
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

// Promotion — automatic price reductions (no code needed). Sellers create these; admins approve.
model Promotion {
  id              String          @id @default(uuid())
  name            String
  description     String?
  type            PromotionType
  discountType    CouponDiscountType
  discountValue   Decimal       @db.Decimal(12, 2)
  status          PromotionStatus @default(DRAFT)
  approvalStatus  ApprovalStatus  @default(PENDING) // PENDING until admin approves (seller promotions)
  rejectionReason String?
  startDate       DateTime
  endDate         DateTime
  // Scope
  sellerId        String?         // Seller who owns this promotion
  seller          SellerProfile?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  categoryId      String?         // For CATEGORY_DISCOUNT type
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Admin-created promotions have approvalStatus = APPROVED by default
  createdByAdmin  Boolean         @default(false)
  products        PromotionProduct[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([approvalStatus])
  @@index([sellerId])
  @@index([startDate])
  @@index([endDate])
}

// PromotionProduct — links promotion to specific products
model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
}

// ============================================================
// PHASE 13 — ANALYTICS
