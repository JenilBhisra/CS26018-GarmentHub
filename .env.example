# Copy this file to .env and fill in your own local values.
# Never commit the real .env file.

# PostgreSQL connection string for the app (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/garmenthub"

# Separate PostgreSQL database used only by tests (required for `npm test` and scripts/test-*.ts).
# The database name MUST end in "_test"; tests refuse to run otherwise.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/garmenthub_test"

# Auth.js / NextAuth v5 secret (required) — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Base URL of the app
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — enables "Sign in with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password for the four demo accounts created by `npx prisma db seed`
# (admin@, seller@, customer@ and b2b@garmenthub.local). Required by the seed script; there is no default.
# Note: running the seed also sets this password on those accounts if they already exist.
SEED_TEST_PASSWORD=""

# Development-only: allows resetFinancialDataDev() (actions/wallets.ts) to wipe
# local financial test data. Leave as "false". Always blocked in production.
ALLOW_DEV_DATA_RESET="false"
